# Copy this file to .env and fill in your own values.
# Never commit the real .env — it is git-ignored.

# ===== Auth database =====
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change_me
AUTH_DB_NAME=auth_db

# ===== Catalog database =====
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=change_me
CATALOG_DB_NAME=catalog_db

# ===== Order database =====
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=change_me
ORDER_DB_NAME=order_db

# ===== JWT =====
# JWT_SECRET is shared by auth-service (signing) and api-gateway (verification):
# both must use the exact same value.
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=7d

# ===== Notification service (Laravel) =====
# Generate with: php artisan key:generate --show
APP_KEY=
